# ===================================================================
# AssIA — Fichier .gitignore
# Regles d'exclusion Git pour Backend FastAPI, Frontend React & Data
# ===================================================================

# -------------------------------------------------------------------
# 1. Python & Caches
# -------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.whl
MANIFEST
*.pyc
*.pyo
.cache/

# -------------------------------------------------------------------
# 2. Environnements virtuels Python
# -------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# -------------------------------------------------------------------
# 3. Variables d'environnement & Secrets
# -------------------------------------------------------------------
.env
.env.local
.env.development
.env.staging
.env.production
!.env.example
*.pem
*.key
*.cert
*.p12
*.crt

# -------------------------------------------------------------------
# 4. Bases de donnees & Stockage local (ChromaDB, SQLite, Uploads)
# -------------------------------------------------------------------
data/app.db
data/app.db-shm
data/app.db-wal
data/*.db
data/*.sqlite
data/*.sqlite3
data/chroma_db/*
!data/chroma_db/.gitkeep
data/uploads/*
!data/uploads/.gitkeep

# -------------------------------------------------------------------
# 5. Logs applicatifs & Traces
# -------------------------------------------------------------------
logs/*
!logs/.gitkeep
*.log

# -------------------------------------------------------------------
# 6. Frontend Node.js / React (Vite)
# -------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.local
frontend/.env.development
frontend/.env.production
frontend/.eslintcache
frontend/package-lock.json.bak

# -------------------------------------------------------------------
# 7. Editeurs, IDEs & Systeme
# -------------------------------------------------------------------
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.bak
*.tmp

# -------------------------------------------------------------------
# 8. Tests & Couverture de code
# -------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.coverage.*
.mypy_cache/
.ruff_cache/

# -------------------------------------------------------------------
# 9. Packaging & Archives
# -------------------------------------------------------------------
*.tar.gz
*.zip
*.7z

# -------------------------------------------------------------------
# 10. Fichiers JSON generes & Caches de test
# (Ne pas ignorer *.json globalement pour preserver package.json, tsconfig.json et realm-export.json)
# -------------------------------------------------------------------
*.tmp.json
tests/coverage_report/
data/*.json

